# ========================================
# StudyFlow Backend Environment Variables
# ========================================
# 
# IMPORTANT: 
# - Copy this file to .env
# - Replace ALL placeholder values with your actual credentials
# - NEVER commit .env to git!
#
# ========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database
# Get from: https://cloud.mongodb.com/
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?appName=StudyFlow

# JWT Authentication Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_random_64_character_secret_key_here

# Google Gemini AI API Key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Public Developer Contact (used by AI assistant)
PUBLIC_DEV_NAME=Salah Uddin Kader
PUBLIC_DEV_CONTACT=salauddinkaderappy@gmail.com
# Optional single URL contact
PUBLIC_DEV_CONTACT_URL=
# Optional JSON array of contacts (overrides the single contact when set)
PUBLIC_DEV_CONTACTS=[{your_contact_json_here}]

# Brevo Email Service
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Brevo SMTP Configuration
# Get from: https://app.brevo.com/settings/keys/smtp
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login_here
EMAIL_PASSWORD=your_brevo_smtp_password_here

# Email Sender Details
FROM_EMAIL=your_email@domain.com
FROM_NAME=StudyFlow Admin

# Frontend URL (for password reset links, CORS, etc.)
FRONTEND_URL=https://yourdomain.com

# Super Admin Credentials (for initial admin user creation)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ========================================
# Security Notes:
# ========================================
#
# 1. MONGODB:
#    - Use strong password with special characters
#    - Whitelist your IP address in MongoDB Atlas
#    - Enable network access restrictions
#
# 2. JWT_SECRET:
#    - MUST be 64+ characters long
#    - Use cryptographically random string
#    - Change it if ever compromised
#
# 3. API KEYS:
#    - Never share or commit to version control
#    - Rotate keys if leaked
#    - Use environment-specific keys (dev/prod)
#
# 4. EMAIL:
#    - Verify sender email in Brevo dashboard
#    - Test email delivery before production
#    - Monitor daily sending limits
#
# ========================================
